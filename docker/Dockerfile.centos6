FROM centos:6

# Configure CentOS 6 Vault repo
RUN sed -i 's/enabled=1/enabled=0/g' /etc/yum/pluginconf.d/fastestmirror.conf || true \
 && sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*.repo \
 && sed -i 's/#baseurl=http:\/\/mirror.centos.org\/centos\/\$releasever/baseurl=http:\/\/vault.centos.org\/6.10/g' /etc/yum.repos.d/CentOS-*.repo

RUN yum install -y openssh-clients cronie ntp tar coreutils which \
 && yum clean all

# Keep the legacy services explicit so the compatibility runner can exercise the same probes as
# production. The image is intentionally x86_64-only and does not install systemd.
RUN test "$(uname -m)" = "x86_64" \
 && test -x /usr/sbin/crond \
 && test -x /usr/sbin/ntpd \
 && ssh-keygen -t rsa -N '' -f /tmp/centos6-compat-key >/dev/null \
 && rm -f /tmp/centos6-compat-key /tmp/centos6-compat-key.pub

ENV BACKUP_PLATFORM_PROFILE=centos6-x86_64
