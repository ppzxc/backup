FROM rust:1-bookworm AS build
WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked --bin backup

FROM golang:1-bookworm AS resticprofile
RUN go install github.com/creativeprojects/resticprofile@latest

FROM debian:bookworm
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl mariadb-client postgresql-client restic rclone openssh-client systemd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /workspace/target/release/backup /usr/local/bin/backup
COPY --from=resticprofile /go/bin/resticprofile /usr/local/bin/resticprofile
STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
